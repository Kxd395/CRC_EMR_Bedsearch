# 🏥 EMR CRC SSOT - Environment Template
# Copy this file to .env and update values for your environment

# API Configuration (REQUIRED)
VITE_API_URL=http://localhost:3001

# Feature Flags
VITE_ENABLE_PLACEMENT_SEARCH=true
VITE_ENABLE_ASSESSMENT_MODULE=true
VITE_ENABLE_FACILITY_FINDER=true
VITE_ENABLE_DEBUG=false

# Development Options
VITE_USE_MOCK_DATA=false
CRC_ENABLE_LOCAL_CACHE=0
VITE_API_TIMEOUT=30000

# Healthcare System Integration URLs
VITE_FACILITY_SYSTEM_URL=https://your-facility-system.com
VITE_ASSESSMENT_SYSTEM_URL=https://your-assessment-system.com
VITE_EMR_INTEGRATION_URL=https://your-emr-system.com

# Security Notes:
# - Never commit actual API keys or credentials
# - Use different values for development/staging/production
# - CRC_ENABLE_LOCAL_CACHE should be 0 in production
# - All healthcare URLs should use HTTPS in production