{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AUTH_REQUEST",
  "type": "object",
  "required": [
    "auth_id",
    "visit_id",
    "status",
    "requirement"
  ],
  "properties": {
    "auth_id": {
      "type": "string"
    },
    "visit_id": {
      "type": "string"
    },
    "patient_id": {
      "type": "string"
    },
    "facility_id": {
      "type": "string"
    },
    "asam_level": {
      "type": "string"
    },
    "payer_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "requirement": {
      "type": "string",
      "enum": [
        "Required",
        "NotRequired",
        "Unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "NotStarted",
        "Required",
        "Submitted",
        "P2P",
        "Approved",
        "Denied",
        "Appeal",
        "NotRequired"
      ]
    },
    "status_reason_code": {
      "type": "string"
    },
    "status_note": {
      "type": "string"
    },
    "method": {
      "type": "string",
      "enum": [
        "Portal",
        "Fax",
        "Phone"
      ]
    },
    "reference_number": {
      "type": "string"
    },
    "submitted_by": {
      "type": "string"
    },
    "submitted_ts": {
      "type": "string",
      "format": "date-time"
    },
    "decision_ts": {
      "type": "string",
      "format": "date-time"
    },
    "decision_agent": {
      "type": "string"
    },
    "coverage_days": {
      "type": "integer",
      "minimum": 0
    },
    "expedited": {
      "type": "boolean"
    },
    "p2p_scheduled_ts": {
      "type": "string",
      "format": "date-time"
    },
    "p2p_clinician": {
      "type": "string"
    },
    "appeal_filed_ts": {
      "type": "string",
      "format": "date-time"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "uploaded_ts": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "user_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "ts",
          "user_id",
          "action"
        ]
      }
    }
  }
}