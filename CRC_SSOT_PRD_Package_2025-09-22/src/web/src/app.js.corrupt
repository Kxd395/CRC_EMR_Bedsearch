    }
  }

  function populateQuickFacilityOptions(patient) {
    if (!dom.quickFacilitySelect) return;
    const rows = patient.searches || [];
    const options = rows.reduce((acc, search) => {
      if (!acc.some((item) => item.value === search.facilityId)) {
        acc.push({ value: search.facilityId, label: search.facilityName });
      }
      return acc;
    }, [{ value: '', label: 'Select facility' }]);
    dom.quickFacilitySelect.innerHTML = options
      .map((opt) => `<option value="${opt.value}">${opt.label}</option>`)
      .join('');
    if (options.length > 1) {
      dom.quickFacilitySelect.value = options[1].value;
    }
  }

  // Global patients data loaded from database
  let loadedPatients = [];
  let databaseLoadAttempted = false;
  let databaseLoadFailed = false;

  async function loadPatientsFromDatabase(retryCount = 0) {
    try {
      console.log(`🔄 Loading patients from database (attempt ${retryCount + 1})...`);
      const baseUrl = import.meta.env.VITE_API_URL || 'http://localhost:3001';
      
      const response = await fetch(`${baseUrl}/api/patients`, {
        method: 'GET',
        headers: {
          'Cache-Control': 'no-cache',
          'Pragma': 'no-cache'
        },
        mode: 'cors',
        credentials: 'same-origin'
      });
      
      if (response.ok) {
        const result = await response.json();
        if (result.success && Array.isArray(result.data)) {
          loadedPatients = result.data;
          databaseLoadFailed = false;
          console.log('✅ Successfully loaded patients from database:', loadedPatients.length);
          return true;
        }
      }
      throw new Error(`Database returned status ${response.status}`);
    } catch (error) {
      console.error('❌ Database load failed:', error.message);
      databaseLoadFailed = true;
      
      // Retry logic with exponential backoff
      if (retryCount < 3) {
        const delay = Math.pow(2, retryCount) * 1000; // 1s, 2s, 4s
        console.log(`⏰ Retrying in ${delay}ms...`);
        await new Promise(resolve => setTimeout(resolve, delay));
        return loadPatientsFromDatabase(retryCount + 1);
      }
      
      return false;
    }
  }

  async function populatePatientSelector() {
    if (!dom.patientSelect) return;
    
    databaseLoadAttempted = true;
    
    // Show loading state
    dom.patientSelect.innerHTML = '<option value="">🔄 Loading patients from database...</option>';
    
    // Try to load from database with retries
    const success = await loadPatientsFromDatabase();
    
    if (success && loadedPatients.length > 0) {
      // Use database patients
      dom.patientSelect.innerHTML = loadedPatients
        .map((p) => `<option value="${p.id}">${p.firstName} ${p.lastName} — ${p.mrn || 'No MRN'}</option>`)
        .join('');
      
      // Set initial patient
      if (!state.currentPatientId || !loadedPatients.find(p => p.id === state.currentPatientId)) {
        state.currentPatientId = loadedPatients[0].id;
      }
      dom.patientSelect.value = state.currentPatientId;
    } else {
      // Only use static fallback if database completely fails after all retries
      console.log('⚠️ Using static patient scenarios as fallback');
      dom.patientSelect.innerHTML = patientScenarios
        .map((p) => `<option value="${p.id}">${p.identifiers.name} — ${p.identifiers.mrn}</option>`)
        .join('');
      
      if (!state.currentPatientId) {
        state.currentPatientId = patientScenarios[0].id;
      }
      dom.patientSelect.value = state.currentPatientId;
      
      // Keep trying to connect to database in background
      scheduleBackgroundDatabaseCheck();
    }
  }

  function scheduleBackgroundDatabaseCheck() {
    // Try to reconnect to database every 10 seconds
    const checkInterval = setInterval(async () => {
      if (!databaseLoadFailed) {
        clearInterval(checkInterval);
        return;
      }
      
      console.log('🔄 Background database check...');
      const success = await loadPatientsFromDatabase(0);
      
      if (success) {
        clearInterval(checkInterval);
        console.log('✅ Database connection restored!');
        
        // Refresh the UI with database data
        await populatePatientSelector();
        renderAll();
        showToast('✅ Database connection restored');
      }
    }, 10000);
  }

  function getCurrentPatient() {
    // Always prioritize database patients if available
    if (loadedPatients.length > 0) {
      const dbPatient = loadedPatients.find((p) => p.id === state.currentPatientId);
      if (dbPatient) {
        // Ensure patient has required structure
        if (!dbPatient.searches) dbPatient.searches = [];
        if (!dbPatient.searchHistory) dbPatient.searchHistory = [];
        if (!dbPatient.note) {
          dbPatient.note = {
            asam: dbPatient.asamLevel || '',
            matNeeds: dbPatient.matNeeds || 'None',
            commitment: dbPatient.commitmentStatus || '',
            acuity: dbPatient.medicalAcuity || '',
            levelOfCare: dbPatient.levelOfCare || '',
            placementNeeded: dbPatient.levelOfCare || ''
          };
        }
        if (!dbPatient.identifiers) {
          dbPatient.identifiers = {
            name: `${dbPatient.lastName}, ${dbPatient.firstName}`,
            mrn: dbPatient.mrn || '',
            fin: dbPatient.fin || '',
            dob: dbPatient.dateOfBirth || ''
          };
        }
        return dbPatient;
      }
    }
    
    // Only fall back to static if database is truly unavailable
    if (databaseLoadFailed) {
      console.warn('⚠️ Using static fallback for patient:', state.currentPatientId);
      return patientScenarios.find((p) => p.id === state.currentPatientId) || patientScenarios[0];
    }
    
    // If database hasn't loaded yet, return a minimal patient object
    console.log('⏳ Database still loading, returning placeholder patient');
    return {
      id: state.currentPatientId || 'loading',
      identifiers: { name: 'Loading...', mrn: '...', fin: '...', dob: '...' },
      note: { asam: '', matNeeds: 'None', commitment: '', acuity: '', levelOfCare: '', placementNeeded: '' },
      searches: [],
      searchHistory: [],
      tasks: [],
      activities: [],
      timeline: { activeIndex: 0, steps: [] },
      audit: [],
      contact: { next: 'Loading...', last: 'Loading...' },
      consent: { act148: false, part2: false }
    };
  }

  // Status styles from updateCard.md specification (canonical snake_case keys)
  const STATUS_STYLES = {
    searching:         { badge:'#6B7280', badgeText: '#ffffff', bg:'#F3F4F6', icon:'⟳', label: 'Searching' },
    packet_sent:       { badge:'#2563EB', badgeText: '#ffffff', bg:'#EFF6FF', icon:'📤', label: 'Packet sent' },
    accepted:          { badge:'#16A34A', badgeText: '#000000', bg:'#ECFDF5', icon:'✓', label: 'Accepted' },
    waiting_transport: { badge:'#4F46E5', badgeText: '#ffffff', bg:'#EEF2FF', icon:'🚗', label: 'Waiting transport' },
    pending_review:    { badge:'#D97706', badgeText: '#000000', bg:'#FFFBEB', icon:'⏰', label: 'Pending review' },
    no_beds:           { badge:'#334155', badgeText: '#ffffff', bg:'#F1F5F9', icon:'🛏️', label: 'No beds' },
    denied:            { badge:'#DC2626', badgeText: '#ffffff', bg:'#FEF2F2', icon:'✗', label: 'Denied' },
    canceled:          { badge:'#0EA5E9', badgeText: '#000000', bg:'#F0F9FF', icon:'🚫', label: 'Canceled' },
    expired:           { badge:'#52525B', badgeText: '#ffffff', bg:'#FAFAFA', icon:'⧗', label: 'Hold expired' },
    reassess_required: { badge:'#C026D3', badgeText: '#ffffff', bg:'#F8E8FF', icon:'⚠️', label: 'Reassess required' }
  };

  function injectStatusThemeStyles() {
    if (typeof document === 'undefined') return;
    const styleId = 'status-theme-styles';
    const existing = document.getElementById(styleId);
    const css = Object.entries(STATUS_STYLES)
      .map(([key, style]) => {
        return `
          .status-theme-${key} {
            --status-badge-color: ${style.badge};
            --status-badge-text: ${style.badgeText};
            --status-bg-color: ${style.bg};
          }
        `;
      })
      .join('\n');

    if (existing) {
      existing.textContent = css;
    } else {
      const styleEl = document.createElement('style');
      styleEl.id = styleId;
      styleEl.textContent = css;
      document.head.appendChild(styleEl);
    }
  }

  const STATUS_KEY_ALIASES = {
    searching: 'searching',
    Searching: 'searching',
    PendingReview: 'pending_review',
    'pending_review': 'pending_review',
    AwaitingCallback: 'pending_review',
    AwaitingFax: 'pending_review',
    AwaitingRounds: 'pending_review',
    PacketSent: 'packet_sent',
    WaitingTransport: 'waiting_transport',
    Accepted: 'accepted',
    Denied: 'denied',
    NoBeds: 'no_beds',
    Canceled: 'canceled',
    Cancelled: 'canceled',
    Expired: 'expired',
    ReassessRequired: 'reassess_required',
    Reassess: 'reassess_required'
  };

  function hexToRgb(hex = '') {
    const normalized = hex.trim().replace('#', '');
    if (![3, 6].includes(normalized.length)) return null;
    const chunkSize = normalized.length === 3 ? 1 : 2;
    const expand = (value) => (value.length === 1 ? value.repeat(2) : value);
    const parts = normalized.match(new RegExp(`.{${chunkSize}}`, 'g')) || [];
    if (parts.length !== 3) return null;
    const [r, g, b] = parts.map((part) => parseInt(expand(part), 16));
    if ([r, g, b].some((value) => Number.isNaN(value))) return null;
    return [r, g, b];
  }

  function srgbToLinearComponent(component) {
    const srgb = component / 255;
    return srgb <= 0.03928 ? srgb / 12.92 : Math.pow((srgb + 0.055) / 1.055, 2.4);
  }

  function luminance(hex) {
    const rgb = hexToRgb(hex);
    if (!rgb) return null;
    const [r, g, b] = rgb.map(srgbToLinearComponent);
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  }

  function contrastRatio(hexA, hexB) {
    const lumA = luminance(hexA);
    const lumB = luminance(hexB);
    if (lumA === null || lumB === null) return null;
    const [light, dark] = lumA > lumB ? [lumA, lumB] : [lumB, lumA];
    return (light + 0.05) / (dark + 0.05);
  }

  function pickBadgeTextColor(badgeHex, threshold = 4.5) {
    const whiteContrast = contrastRatio(badgeHex, '#ffffff');
    const blackContrast = contrastRatio(badgeHex, '#000000');

    if (whiteContrast !== null && whiteContrast >= threshold) {
      return '#ffffff';
    }

    if (blackContrast !== null && blackContrast >= threshold) {
      return '#000000';
    }

    if (whiteContrast === null && blackContrast === null) {
      return '#000000';
    }

    if ((whiteContrast || 0) >= (blackContrast || 0)) {
      return '#ffffff';
    }

    return '#000000';
  }

  function normalizeStatusKey(raw) {
    if (raw === undefined || raw === null) return 'searching';
    if (STATUS_KEY_ALIASES[raw]) return STATUS_KEY_ALIASES[raw];
    const compact = String(raw)
      .toLowerCase()
      .trim()
      .replace(/\s+|[-–—]/g, '_')
      .replace(/[^a-z0-9_]/g, '');
    if (STATUS_KEY_ALIASES[compact]) return STATUS_KEY_ALIASES[compact];
    if (STATUS_STYLES[compact]) return compact;
    return 'searching';
  }

  function getStatusPresentation(rawStatus) {
    const key = normalizeStatusKey(rawStatus);
    const style = STATUS_STYLES[key] || STATUS_STYLES.searching;
    const badgeColor = style.badge || '#6B7280';
    const badgeTextColor = style.badgeText || pickBadgeTextColor(badgeColor);
    return {
      key,
      label: style.label || key.replace(/_/g, ' ').replace(/\b\w/g, (m) => m.toUpperCase()),
      icon: style.icon || '',
      badgeColor,
      badgeTextColor,
      backgroundColor: style.bg || '#F3F4F6'
    };
  }

  const channelLabels = {
    fax: 'Fax',
    phone: 'Phone',
    email: 'Secure Email',
    portal: 'Provider Portal'
  };

