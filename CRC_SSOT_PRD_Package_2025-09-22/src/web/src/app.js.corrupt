  function filterFacilityResults() {
    if (!dom.facilitySearch || !dom.results) return;
    const term = dom.facilitySearch.value.trim().toLowerCase();
    const patient = getCurrentPatient();
    
    // Start with LOC-filtered facilities instead of all facilities
    const baseFilteredFacilities = getFilteredFacilitiesForPatient(patient);
    
    const filtered = baseFilteredFacilities.filter((facility) => {
      if (!term) {
        return true;
      }
      const haystack = [
        facility.name,
        facility.locationSummary,
        facility.address,
        ...(facility.services || []),
        ...(facility.tags || [])
      ]
        .filter(Boolean)
        .map((value) => value.toLowerCase());
      return haystack.some((value) => value.includes(term));
    });
    if (dom.clearSearch) {
      dom.clearSearch.disabled = !term;
    }
    const list = term ? filtered : baseFilteredFacilities;
    dom.results.innerHTML = renderFacilityCards(list);
    attachFacilityCardEvents();

    // Keep default filters tied to current patient even while searching
    renderStoryboard(patient);
  }

  function resetFacilitySearch() {
    if (!dom.facilitySearch) return;
    dom.facilitySearch.value = '';
    if (dom.clearSearch) {
      dom.clearSearch.disabled = true;
    }
    renderFacilityResults(getCurrentPatient());
  }

  function getFilteredFacilitiesForPatient(patient) {
    console.log('🔍 DEBUG: getFilteredFacilitiesForPatient called');
    console.log('🔍 DEBUG: Patient ASAM:', patient?.note?.asam);
    console.log('🔍 DEBUG: LOC maps available:', !!locLookupMaps.facilityByLoc);
    
    if (!patient?.note?.asam || !locLookupMaps.facilityByLoc) {
      console.log('🔍 DEBUG: No ASAM or LOC data, returning all facilities:', facilityDirectory.length);
      return facilityDirectory; // Return all facilities if no ASAM level or LOC data unavailable
    }

    const defaultAsam = patient.note.asam;
    
    // Handle new JSON format for MAT needs
    const matNeedsRaw = patient.note.matNeeds;
    const defaultMat = matNeedsRaw && typeof matNeedsRaw === 'object' && matNeedsRaw.type 
      ? matNeedsRaw.type 
      : matNeedsRaw || 'None';
      
    const needs302 = (patient.note.commitment || '').toLowerCase().includes('302');
    const needsSecure = patient.note.acuity === 'Secured';

    console.log('🔍 DEBUG: Filter criteria:', { defaultAsam, defaultMat, needs302, needsSecure });

    // Use LOC-based filtering
    const asamLevels = Array.isArray(defaultAsam) ? defaultAsam : [defaultAsam];
    console.log('🔍 DEBUG: ASAM levels for filtering:', asamLevels);
    
    const filtered = filterFacilitiesByLoc(facilityDirectory, asamLevels, locLookupMaps.facilityByLoc, {
      needs302,
      needsSecure
    });
    
    console.log('🔍 DEBUG: After LOC filtering:', filtered.length);

    // Apply scoring to prioritize facilities
    const scored = filtered.map((facility) => {
      let score = 0;
      const haystack = [
        facility.level,
        facility.category,
        ...(facility.services || []),
        ...(facility.tags || [])
      ]
        .filter(Boolean)
        .map((value) => value.toLowerCase());

      // Enhanced scoring with LOC compatibility
      const matchingLocLevels = mapAsamToLocLevels(defaultAsam);
      const facilityNameLower = facility.name.toLowerCase();
      
      // Check if facility provides any of the required LOC levels
      const providesRequiredLoc = matchingLocLevels.some(locLevel => {
        const facilitiesForLoc = locLookupMaps.facilityByLoc.get(locLevel);
        return facilitiesForLoc && facilitiesForLoc.has(facilityNameLower);
      });
      
      if (providesRequiredLoc) {
        score += 5; // High priority for LOC match
      }

      // Additional scoring criteria
      if (defaultMat && defaultMat !== 'None') {
        const matKey = defaultMat.toLowerCase();
        if (matKey.includes('methadone') && haystack.some((value) => value.includes('methadone'))) {
          score += 2;
        }
        if (matKey.includes('suboxone') && haystack.some((value) => value.includes('suboxone'))) {
          score += 2;
        }
      }

      if (facility.availability === 'Accepting') score += 1;
      if (facility.operationalData?.acceptingAdmissions) score += 1;
      return { facility, score };
    });

    // Sort by score then alphabetically
    return scored
      .sort((a, b) => {
        if (b.score !== a.score) {
          return b.score - a.score;
        }
        return a.facility.name.localeCompare(b.facility.name);
      })
      .map(({ facility }) => facility);
  }

  function openSearchPopover() {
    console.log('🚀 DEBUG: openSearchPopover called');
    
    if (!dom.searchPopover) {
      console.error('❌ DEBUG: dom.searchPopover not found!');
      return;
    }
    
    const patient = getCurrentPatient();
    console.log('🔍 DEBUG: Current patient:', patient?.id);
    
    dom.searchPopover.classList.remove('hidden');
    
    // Debug: Log patient ASAM level and filtering
    console.log('🔍 DEBUG: Patient ASAM level:', patient?.note?.asam);
    console.log('🔍 DEBUG: LOC lookup maps available:', !!locLookupMaps.facilityByLoc);
    console.log('🔍 DEBUG: facilityDirectory total length:', facilityDirectory.length);
    console.log('🔍 DEBUG: First 3 facilities:', facilityDirectory.slice(0, 3).map(f => f.name));
    
    // Use LOC-filtered facilities based on patient's ASAM level
    const filteredFacilities = getFilteredFacilitiesForPatient(patient);
    
    // Debug: Log facility counts
    console.log('🔍 DEBUG: Total facilities:', facilityDirectory.length);
    console.log('🔍 DEBUG: Filtered facilities:', filteredFacilities.length);
    console.log('🔍 DEBUG: First 3 filtered:', filteredFacilities.slice(0, 3).map(f => f.name));
    
    if (dom.searchFacilities) {
      dom.searchFacilities.innerHTML = filteredFacilities
        .map((facility) => {
          // Add LOC indicator to facility name
          const facilityLocs = locLookupMaps.facilityByLoc ? getFacilityLocLevels(facility.name, locLookupMaps) : [];
          const locIndicator = facilityLocs.length > 0 ? ` [${facilityLocs.map(loc => loc.asamLevel).join(', ')}]` : '';
          return `<option value="${facility.id}">${facility.name}${locIndicator}</option>`;
        })
        .join('');
    }
    if (dom.searchFacilityChips) {
      dom.searchFacilityChips.innerHTML = patient.searches
        .map((search) => `<span class="chip">${search.facilityName}</span>`)
        .join('');
    }
    if (dom.searchNotes) {
      dom.searchNotes.value = '';
    }
    if (dom.searchResults) {
      const previewFacilities = filteredFacilities.slice(0, 3);
      dom.searchResults.innerHTML = previewFacilities
        .map((facility) => {
          const metaLine = [facility.availability, ...getFacilityMetaParts(facility)]
            .filter(Boolean)
            .join(' • ') || 'Details unavailable';
          const notes = facility.notes || 'No notes available.';
          
          // Add LOC information to the preview
          const facilityLocs = locLookupMaps.facilityByLoc ? getFacilityLocLevels(facility.name, locLookupMaps) : [];
          const locInfo = facilityLocs.length > 0 ? `LOC: ${facilityLocs.map(loc => loc.displayName).join(', ')}` : '';
          const displayMeta = locInfo ? `${metaLine} • ${locInfo}` : metaLine;
          
          return `
          <div class="search-result-card">
            <strong>${facility.name}</strong>
            <p>${notes}</p>
            <small>${displayMeta}</small>
          </div>
        `;
        })
        .join('');
    }
  }

  function closeSearchPopover() {
    if (dom.searchPopover) {
      dom.searchPopover.classList.add('hidden');
    }
  }

  async function handleSearchPublish() {
    const patient = getCurrentPatient();
    if (!dom.searchFacilities) return;
    
    const selectedFacilityIds = Array.from(dom.searchFacilities.selectedOptions).map(option => option.value);
    if (selectedFacilityIds.length === 0) {
      showToast('Please select at least one facility to add to the search list.');
      return;
    }

    let addedCount = 0;
    selectedFacilityIds.forEach(facilityId => {
      const facility = facilityDirectory.find(f => f.id === facilityId);
      if (!facility) return;

      // Check if this facility is already being searched for this patient
      const existingSearch = patient.searches.find(s => s.facilityId === facilityId);
      if (existingSearch) {
        showToast(`${facility.name} is already in the search list.`);
        return;
      }

      // Create new search entry
      const now = new Date();
      const timestamp = `${(now.getMonth() + 1).toString().padStart(2, '0')}/${now.getDate().toString().padStart(2, '0')} ${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
      const searchId = `S${patient.id}-${(patient.searches.length + 1).toString().padStart(2, '0')}`;

      const newSearch = {
        id: searchId,
        facilityId: facility.id,
        facilityName: facility.name,
        status: 'Pending',
        updated: timestamp,
        created: timestamp,
        channels: ['fax'],
        summary: 'New search added from facility directory.',
        assignedTo: 'mlee',
        timeBucket: 'today'
      };

      patient.searches.push(newSearch);
      
      // Add to search history
      patient.searchHistory.unshift({
        ts: timestamp,
        status: 'Pending',
        facility: facility.name,
        detail: 'Search initiated from facility directory.'
      });
      
      addedCount++;
    });

    if (addedCount > 0) {
      try {
        // CRITICAL: Properly await the save operation
        await savePatientData(patient);
        showToast(`✅ Added ${addedCount} ${addedCount === 1 ? 'facility' : 'facilities'} to search list and saved to database`);
        renderActiveSearches(patient);
        closeSearchPopover();
      } catch (error) {
        console.error('Failed to persist published search list changes', error);
        showToast('❌ Failed to save searches - please try again');
        // Revert the changes since save failed
        patient.searches = patient.searches.slice(0, -addedCount);
        patient.searchHistory = patient.searchHistory.slice(addedCount);
        renderActiveSearches(patient);
      }
    }
  }

