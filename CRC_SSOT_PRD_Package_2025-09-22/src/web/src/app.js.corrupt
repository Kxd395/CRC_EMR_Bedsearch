    { value: 'ACCEPT_EMAIL', label: 'Accept — Email confirmation' },
    { value: 'PACKET_SENT', label: 'Packet sent' },
    { value: 'PENDING_AWAITING_ROUNDS', label: 'Pending — Awaiting rounds' },
