@startuml DATAFLOW_ADD_EVENT
!theme plain
skinparam backgroundColor white

title Event Processing Data Flow

actor "User" as user
participant "UI Form" as ui
participant "API Gateway" as api
participant "Event Validator" as validator
participant "Database" as db
participant "Status Engine" as engine
participant "WebSocket" as ws
participant "Connected Clients" as clients

user -> ui : Submit event\n(call outcome, note, etc.)
activate ui

ui -> api : POST /events\n{type, data, bed_search_id}
activate api

api -> validator : Validate event structure\nand permissions
activate validator

alt Event Invalid
    validator -> api : Validation error
    api -> ui : 400 Bad Request
    ui -> user : Show error message
else Event Valid
    validator -> db : BEGIN transaction
    activate db
    
    validator -> db : INSERT INTO bed_search_event\n(bed_search_id, event_type, event_data, user_id)
    db -> validator : Event ID returned
    
    validator -> engine : Trigger status derivation\nfor bed_search_id
    activate engine
    
    engine -> db : SELECT events\nWHERE bed_search_id = ?\nORDER BY created_at DESC
    db -> engine : Event history
    
    engine -> engine : Apply precedence rules\nCalculate primary stage\nDetermine facets
    
    engine -> db : UPDATE bed_search SET\nstatus = ?, version = version + 1\nWHERE id = ?
    db -> engine : Rows updated
    
    engine -> db : COMMIT transaction
    deactivate db
    
    engine -> ws : Broadcast update\n{bed_search_id, status, version}
    activate ws
    
    ws -> clients : Send to all connected\nclients watching this search
    activate clients
    
    clients -> clients : Auto-refresh UI\nUpdate card colors\nShow new facets
    deactivate clients
    deactivate ws
    
    engine -> api : Success response\n{status, version, facets}
    deactivate engine
    
    api -> ui : 200 OK\n{updated_status}
    deactivate validator
    deactivate api
    
    ui -> user : Show success feedback\nRefresh card display
    deactivate ui
end

note right of engine
  Status derivation is deterministic:
  1. Sort events DESC by timestamp
  2. Apply stage precedence rules
  3. Handle time-based logic
  4. Calculate facets
  5. Ensure consistency
end note

note right of db
  UNIQUE constraint prevents
  duplicate active searches:
  (facility_id, fin) WHERE 
  archived_at IS NULL
end note

note right of ws
  Real-time updates eliminate
  need for polling and ensure
  all users see changes
  immediately
end note

@enduml