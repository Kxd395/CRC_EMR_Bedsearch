# 🔐 EMR Database Configuration Template
# Copy this to .env and update with your actual credentials
# NEVER commit .env files to version control!

# ===========================================
# EMR Database Connection Configuration
# ===========================================

# Complete PostgreSQL Connection URL (recommended)
# Format: postgresql://username:password@host:port/database
EMR_DATABASE_URL="postgresql://emr_admin:CHANGE_THIS_PASSWORD@100.112.67.23:5432/emr_placement_ssot"

# Alternative: Individual connection parameters
EMR_DB_HOST="100.112.67.23"
EMR_DB_PORT="5432"
EMR_DB_NAME="emr_placement_ssot"
EMR_DB_USER="emr_admin"
EMR_DB_PASSWORD="CHANGE_THIS_PASSWORD"

# ===========================================
# SSH Connection Configuration (for remote deployment)
# ===========================================

# SSH connection details for database server
SSH_HOST="100.112.67.23"
SSH_PORT="2222"
SSH_USER="kxd395"
SSH_KEY_PATH="$HOME/.ssh/homelab"

# Alternative SSH host (local network fallback)
SSH_HOST_LOCAL="192.168.0.40"

# ===========================================
# Healthcare Application Configuration
# ===========================================

# Application name (for audit logging)
APP_NAME="EMR_Healthcare_Application"

# HIPAA compliance settings
AUDIT_LOG_RETENTION_DAYS="2555"  # 7 years for HIPAA
PHI_ACCESS_LOGGING="true"
AUDIT_FAILED_LOGINS="true"

# Clinical workflow settings
DEFAULT_PRIORITY_LEVEL="medium"
EMERGENCY_RESPONSE_HOURS="4"
HIGH_PRIORITY_RESPONSE_HOURS="8"
MEDIUM_PRIORITY_RESPONSE_HOURS="24"

# ===========================================
# Security Configuration
# ===========================================

# Password requirements
MIN_PASSWORD_LENGTH="12"
REQUIRE_SPECIAL_CHARS="true"
PASSWORD_EXPIRY_DAYS="90"

# Session management
SESSION_TIMEOUT_MINUTES="30"
MAX_LOGIN_ATTEMPTS="3"
ACCOUNT_LOCKOUT_MINUTES="15"

# Encryption settings
ENCRYPT_PHI_AT_REST="true"
ENCRYPT_PHI_IN_TRANSIT="true"
TLS_MIN_VERSION="1.2"

# ===========================================
# Monitoring and Alerting
# ===========================================

# Health check endpoints
HEALTH_CHECK_INTERVAL_SECONDS="60"
DATABASE_TIMEOUT_SECONDS="10"

# Alerting thresholds
MAX_FAILED_CONNECTIONS="5"
MAX_QUERY_TIME_SECONDS="30"
MAX_CONCURRENT_CONNECTIONS="50"

# Log levels (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL="INFO"
AUDIT_LOG_LEVEL="INFO"

# ===========================================
# Development vs Production Settings
# ===========================================

# Environment (development, staging, production)
NODE_ENV="development"
EMR_ENVIRONMENT="development"

# Development-specific settings (set to false in production)
DEBUG_MODE="true"
SAMPLE_DATA_ENABLED="true"
DETAILED_ERROR_MESSAGES="true"

# Production-specific settings (set to true in production)
REQUIRE_SSL="false"
ENFORCE_RATE_LIMITING="false"
ENABLE_AUDIT_ALERTS="false"

# ===========================================
# Backup and Recovery Configuration
# ===========================================

# Backup settings
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS="30"
BACKUP_LOCATION="/home/kxd395/backups/emr"

# Recovery settings
POINT_IN_TIME_RECOVERY="true"
WAL_ARCHIVING="true"

# ===========================================
# Performance Tuning
# ===========================================

# Connection pooling
DB_POOL_MIN_SIZE="5"
DB_POOL_MAX_SIZE="20"
DB_POOL_IDLE_TIMEOUT="30000"
DB_POOL_CONNECTION_TIMEOUT="2000"

# Query optimization  
DB_STATEMENT_TIMEOUT="300000"  # 5 minutes
DB_QUERY_TIMEOUT="30000"       # 30 seconds

# ===========================================
# Healthcare-Specific Configuration
# ===========================================

# Facility capabilities
ACCEPT_302_HOLDS="true"
ACCEPT_MAT_TREATMENT="true" 
ACCEPT_SECURE_UNITS="true"
ACCEPT_DETOX_SERVICES="true"

# Clinical workflow defaults
DEFAULT_LOS_DAYS="7"  # Length of stay
AUTHORIZATION_REQUIRED="true"
INSURANCE_VERIFICATION_REQUIRED="true"

# Patient privacy settings
MINIMUM_AGE_CONSENT="18"
REQUIRE_GUARDIAN_CONSENT_UNDER="18"
PHI_RETENTION_YEARS="7"

# ===========================================
# Integration Configuration
# ===========================================

# HL7 FHIR integration (future)
FHIR_ENDPOINT_URL=""
FHIR_CLIENT_ID=""
FHIR_CLIENT_SECRET=""

# Electronic Health Record integration (future)
EHR_INTEGRATION_ENABLED="false"
EHR_API_ENDPOINT=""
EHR_API_KEY=""

# Insurance verification API (future)  
INSURANCE_API_ENABLED="false"
INSURANCE_API_ENDPOINT=""
INSURANCE_API_KEY=""

# ===========================================
# Compliance and Reporting
# ===========================================

# HIPAA reporting
HIPAA_OFFICER_EMAIL=""
BREACH_NOTIFICATION_EMAIL=""
COMPLIANCE_REPORT_SCHEDULE="monthly"

# Quality metrics
TRACK_PLACEMENT_TIMES="true"
TRACK_PATIENT_OUTCOMES="true"
GENERATE_QUALITY_REPORTS="true"

# ===========================================
# Notification Configuration  
# ===========================================

# Email settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""

# SMS settings (for critical alerts)
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_FROM_NUMBER=""

# Emergency notification
EMERGENCY_CONTACT_EMAIL=""
EMERGENCY_CONTACT_PHONE=""
CRITICAL_ALERT_ENABLED="false"

# ===========================================
# Usage Instructions
# ===========================================

# 1. Copy this file to .env:
#    cp config/emr_config.env.example .env

# 2. Update all passwords and sensitive values:
#    - Change EMR_DB_PASSWORD to a secure password
#    - Update SSH_KEY_PATH to your actual SSH key
#    - Set appropriate email addresses for notifications

# 3. For production deployment:
#    - Set NODE_ENV="production"
#    - Set REQUIRE_SSL="true"
#    - Set DEBUG_MODE="false"
#    - Enable monitoring and alerting
#    - Configure backup schedules

# 4. Test your configuration:
#    ./deployment_scripts/validate_emr_schema.sh

# 5. Deploy to production:
#    ./deployment_scripts/apply_schema.sh

# ===========================================
# Security Notes
# ===========================================

# ⚠️  IMPORTANT SECURITY REMINDERS:
# 
# 1. Never commit .env files to version control
# 2. Use strong, unique passwords for all accounts
# 3. Rotate passwords regularly (every 90 days)
# 4. Enable two-factor authentication where possible
# 5. Monitor audit logs for suspicious activity
# 6. Keep PostgreSQL and system software updated
# 7. Use encrypted connections (SSL/TLS) in production
# 8. Implement proper backup and disaster recovery
# 9. Regular security audits and penetration testing
# 10. Staff training on HIPAA compliance requirements

# For additional security guidance, refer to:
# - ../docs/SECURITY_BEST_PRACTICES.md
# - ../docs/HIPAA_COMPLIANCE_GUIDE.md
# - ../docs/DISASTER_RECOVERY_PLAN.md