# EMR CRC SSOT Environment Configuration Template
# 🚨 SECURITY WARNING: Never commit actual values - use placeholders only!
# 
# Instructions:
# 1. Copy this file to .env in your deployment environment
# 2. Replace ALL placeholder values with actual configuration
# 3. Verify no hardcoded values remain in source code
# 4. Run security scan before deployment

# =============================================================================
# UI/CLIENT CONFIGURATION (Vite Environment Variables)
# =============================================================================

# API Endpoint Configuration - MUST match your deployed API server
VITE_API_URL=https://your-api-domain.com
VITE_NODE_ENV=production

# Healthcare System Integration (Optional)
VITE_FACILITY_SYSTEM_URL=https://your-facility-system.com
VITE_ASSESSMENT_SYSTEM_URL=https://your-assessment-system.com

# Feature Flags for Healthcare Modules
VITE_ENABLE_PLACEMENT_SEARCH=true
VITE_ENABLE_ASSESSMENT_MODULE=true
VITE_ENABLE_FACILITY_FINDER=true
VITE_ENABLE_TRANSPORT_SCHEDULING=false
VITE_USE_MOCK_DATA=false
VITE_ENABLE_DEBUG=false

# =============================================================================
# API SERVER CONFIGURATION (Node.js Environment Variables)
# =============================================================================

# Database Connection - PostgreSQL Required
DB_HOST=your-postgres-host.com
DB_PORT=5432
DB_NAME=emr_crc_ssot
DB_USER=your-db-username
DB_PASSWORD=your-secure-db-password
DB_SSL=true
DATABASE_URL=postgresql://username:password@hostname:port/database

# Server Configuration
PORT=3001
NODE_ENV=production

# Healthcare Security & Compliance
JWT_SECRET=your-super-secure-jwt-secret-minimum-256-bits
SESSION_SECRET=your-session-secret-for-healthcare-data
ENCRYPTION_KEY=your-aes-256-encryption-key

# HIPAA Compliance Settings
AUDIT_LOG_ENABLED=true
DATA_RETENTION_DAYS=2555  # 7 years for healthcare records
PATIENT_DATA_ENCRYPTION=true

# External Healthcare APIs (if applicable)
EMR_INTEGRATION_API_KEY=your-emr-api-key
FACILITY_DIRECTORY_API_KEY=your-facility-api-key
INSURANCE_VERIFICATION_API_KEY=your-insurance-api-key

# Email/Notification Services
SMTP_HOST=your-smtp-host.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
NOTIFICATION_EMAIL=notifications@your-domain.com

# File Upload & Storage
UPLOAD_MAX_SIZE=10485760  # 10MB for healthcare documents
STORAGE_PROVIDER=s3  # Options: local, s3, azure
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=your-hipaa-compliant-s3-bucket

# Monitoring & Error Tracking
ERROR_TRACKING_DSN=your-sentry-or-bugsnag-dsn
MONITORING_API_KEY=your-monitoring-service-key
LOG_LEVEL=info

# =============================================================================
# DEPLOYMENT PLATFORM SPECIFIC
# =============================================================================

# Railway.app
RAILWAY_PROJECT_ID=your-railway-project-id
RAILWAY_SERVICE_ID=your-railway-service-id

# Render.com
RENDER_SERVICE_ID=your-render-service-id

# Netlify Functions (if using serverless)
NETLIFY_SITE_ID=your-netlify-site-id
NETLIFY_AUTH_TOKEN=your-netlify-auth-token

# =============================================================================
# DEVELOPMENT OVERRIDES (for local development only)
# =============================================================================

# Uncomment and modify for local development:
# VITE_API_URL=http://localhost:3001
# DB_HOST=localhost
# NODE_ENV=development
# DB_SSL=false
# AUDIT_LOG_ENABLED=false