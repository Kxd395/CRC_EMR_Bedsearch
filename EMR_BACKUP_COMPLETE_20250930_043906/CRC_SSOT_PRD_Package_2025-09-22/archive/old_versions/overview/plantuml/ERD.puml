@startuml ERD
!theme plain
skinparam backgroundColor white

title Bed-Search Database Schema

entity "bed_search" as search {
  * id : SERIAL <<PK>>
  --
  * facility_id : INTEGER <<FK>>
  * fin : VARCHAR
  * patient_id : INTEGER <<FK>>
  * created_at : TIMESTAMP
  * archived_at : TIMESTAMP
  * status : VARCHAR (derived)
  * version : INTEGER (optimistic lock)
  --
  UNIQUE INDEX: (facility_id, fin) 
  WHERE archived_at IS NULL
}

entity "bed_search_event" as event {
  * id : SERIAL <<PK>>
  --
  * bed_search_id : INTEGER <<FK>>
  * event_type : VARCHAR
  * event_data : JSONB
  * created_at : TIMESTAMP
  * user_id : INTEGER <<FK>>
  --
  Append-only (never updated/deleted)
}

entity "bed_search_note" as note {
  * id : SERIAL <<PK>>
  --
  * bed_search_id : INTEGER <<FK>>
  * note_text : TEXT
  * note_type : VARCHAR
  * created_at : TIMESTAMP
  * user_id : INTEGER <<FK>>
}

entity "patient" as patient {
  * id : SERIAL <<PK>>
  --
  * mrn : VARCHAR
  * first_name : VARCHAR
  * last_name : VARCHAR
  * date_of_birth : DATE
  * insurance_info : JSONB
}

entity "visit" as visit {
  * id : SERIAL <<PK>>
  --
  * fin : VARCHAR <<UK>>
  * patient_id : INTEGER <<FK>>
  * admission_date : TIMESTAMP
  * discharge_date : TIMESTAMP
  * visit_type : VARCHAR
  * status : VARCHAR
}

entity "facility" as facility {
  * id : SERIAL <<PK>>
  --
  * name : VARCHAR
  * facility_type : VARCHAR
  * address : TEXT
  * phone : VARCHAR
  * bed_capacity : INTEGER
  * current_occupancy : INTEGER
  * accepts_insurance : JSONB
}

entity "user" as user {
  * id : SERIAL <<PK>>
  --
  * username : VARCHAR
  * email : VARCHAR
  * role : VARCHAR
  * department : VARCHAR
  * active : BOOLEAN
}

' Primary relationships
search ||--o{ event : "has events"
search ||--o{ note : "has notes"
search }o--|| patient : "belongs to"
search }o--|| facility : "targets"
search }o--|| visit : "references FIN"

' Event/note creators
event }o--|| user : "created by"
note }o--|| user : "created by"

' Patient-visit relationship
patient ||--o{ visit : "has visits"

' Indexes and constraints
note top of search : "UNIQUE INDEX ensures one active\nsearch per (facility_id, fin)\nHistorical data preserved when\narchived_at is populated"

note top of event : "Events are immutable and append-only\nComplete audit trail is maintained\nStatus derived from event history"

note right of facility : "Facility capacity and insurance\nacceptance rules drive placement\neligibility and bed availability"

note left of visit : "FIN (Financial Identifier Number)\nuniquely identifies each patient visit\nLinks placement requests to episodes"

note bottom of user : "All events and notes are attributed\nto users for accountability and\naudit trail compliance"

@enduml