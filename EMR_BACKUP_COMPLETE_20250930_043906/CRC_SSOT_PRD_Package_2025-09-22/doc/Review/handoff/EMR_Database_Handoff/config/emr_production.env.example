# EMR Database System - Environment Configuration
# Production Environment Settings
# Created: September 30, 2025
# Version: 1.0.0
# 
# IMPORTANT: Copy this to .env and fill in your actual values
# Never commit .env files with real credentials to version control

# ===========================================
# HOME LAB INTEGRATION
# ===========================================

# Home Lab Base Configuration
HOME_LAB_BASE_PATH="/Applications/MyApps/Home_System"
PROJECT_NAME="emr_database_system"
ENVIRONMENT="production"
CONFIG_VERSION="1.0.0"

# ===========================================
# NETWORK CONFIGURATION
# ===========================================

# Primary Database Server (Tailscale VPN)
EMR_DATABASE_HOST="100.112.67.23"
EMR_DATABASE_PORT="5432"

# SSH Configuration
SSH_HOST="100.112.67.23"
SSH_PORT="2222"
SSH_USER="kxd395"
SSH_KEY_PATH="${HOME}/.ssh/homelab"

# Development Environment (Docker)
EMR_DATABASE_DEV_HOST="localhost"
EMR_DATABASE_DEV_PORT="5433"

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Database Names
EMR_DATABASE_NAME="emr_placement_ssot"
EMR_DATABASE_TEST_NAME="emr_placement_test"

# Database Users (Set actual values in .env)
EMR_DB_ADMIN_USER="emr_admin"
EMR_DB_ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"

EMR_DB_APP_USER="emr_app"
EMR_DB_APP_PASSWORD="CHANGE_ME_APP_PASSWORD"

EMR_DB_READONLY_USER="emr_readonly"
EMR_DB_READONLY_PASSWORD="CHANGE_ME_READONLY_PASSWORD"

# Connection Pool Settings
EMR_DB_POOL_MIN="5"
EMR_DB_POOL_MAX="20"
EMR_DB_TIMEOUT="30000"

# Database URLs (Constructed from above)
EMR_DATABASE_URL="postgresql://${EMR_DB_APP_USER}:${EMR_DB_APP_PASSWORD}@${EMR_DATABASE_HOST}:${EMR_DATABASE_PORT}/${EMR_DATABASE_NAME}"
EMR_DATABASE_ADMIN_URL="postgresql://${EMR_DB_ADMIN_USER}:${EMR_DB_ADMIN_PASSWORD}@${EMR_DATABASE_HOST}:${EMR_DATABASE_PORT}/${EMR_DATABASE_NAME}"
EMR_DATABASE_READONLY_URL="postgresql://${EMR_DB_READONLY_USER}:${EMR_DB_READONLY_PASSWORD}@${EMR_DATABASE_HOST}:${EMR_DATABASE_PORT}/${EMR_DATABASE_NAME}"

# ===========================================
# HEALTHCARE APPLICATION SETTINGS
# ===========================================

# System Information
EMR_SYSTEM_NAME="EMR Patient Placement System"
EMR_VERSION="1.0.0"
HIPAA_COMPLIANCE="true"

# Clinical Workflow Settings
DEFAULT_PRIORITY="medium"
CRITICAL_RESPONSE_TIME="3600"    # 1 hour in seconds
HIGH_RESPONSE_TIME="14400"       # 4 hours in seconds
MEDIUM_RESPONSE_TIME="43200"     # 12 hours in seconds
LOW_RESPONSE_TIME="86400"        # 24 hours in seconds

# Placement Types (comma-separated)
PLACEMENT_TYPES="admission,transfer,readmission,302_hold,mat_treatment,detox,emergency,planned"

# Facility Capabilities
FACILITY_CAPABILITIES="accepts_302,accepts_mat,accepts_secure,accepts_detox,accepts_pediatric,accepts_geriatric,accepts_dual_diagnosis"

# ===========================================
# SECURITY CONFIGURATION
# ===========================================

# Authentication
AUTH_METHOD="database"
REQUIRE_2FA="false"
SESSION_TIMEOUT_MINUTES="30"
MAX_LOGIN_ATTEMPTS="3"

# Encryption Settings
PHI_ENCRYPTION_ENABLED="true"
DATABASE_SSL_ENABLED="true"
BACKUP_ENCRYPTION_ENABLED="true"

# JWT Settings (Generate with: openssl rand -hex 32)
JWT_SECRET="CHANGE_ME_JWT_SECRET_32_CHARS_MIN"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# API Keys (Generate with: openssl rand -base64 32)
API_KEY_PRIMARY="CHANGE_ME_PRIMARY_API_KEY"
API_KEY_SECONDARY="CHANGE_ME_SECONDARY_API_KEY"
WEBHOOK_SECRET="CHANGE_ME_WEBHOOK_SECRET"

# PHI Encryption Key (Generate with: openssl rand -base64 32)
PHI_ENCRYPTION_KEY="CHANGE_ME_PHI_ENCRYPTION_KEY_32_CHARS"

# ===========================================
# HIPAA COMPLIANCE SETTINGS
# ===========================================

# Audit Logging
AUDIT_LOGGING_ENABLED="true"
AUDIT_LOG_LEVEL="INFO"
AUDIT_RETENTION_DAYS="2555"  # 7 years as required by HIPAA
AUDIT_ENCRYPTION_ENABLED="true"

# Audit Database (Separate for security)
AUDIT_DATABASE_URL="postgresql://${EMR_DB_ADMIN_USER}:${EMR_DB_ADMIN_PASSWORD}@${EMR_DATABASE_HOST}:${EMR_DATABASE_PORT}/emr_audit"

# Breach Notification
BREACH_NOTIFICATION_ENABLED="true"
BREACH_NOTIFICATION_EMAIL="compliance@homelab.local"

# Access Control
ROLE_BASED_ACCESS="true"
RESTRICT_PHI_ACCESS="true"
REQUIRE_ACCESS_JUSTIFICATION="true"

# ===========================================
# DOCKER DEVELOPMENT ENVIRONMENT
# ===========================================

# pgAdmin Configuration
PGADMIN_EMAIL="admin@homelab.local"
PGADMIN_PASSWORD="CHANGE_ME_PGADMIN_PASSWORD"
PGADMIN_PORT="8080"

# Redis Configuration
REDIS_PASSWORD="CHANGE_ME_REDIS_PASSWORD"
REDIS_PORT="6379"

# Monitoring Ports
PROMETHEUS_PORT="9090"
POSTGRES_EXPORTER_PORT="9187"

# ===========================================
# BACKUP CONFIGURATION
# ===========================================

# Backup Settings
BACKUP_ENABLED="true"
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS="30"
BACKUP_LOCATION="/home/kxd395/backups/emr"
BACKUP_ENCRYPTION_ENABLED="true"

# Backup Database URLs
BACKUP_SOURCE_URL="${EMR_DATABASE_ADMIN_URL}"
BACKUP_COMPRESSION="gzip"
BACKUP_FORMAT="custom"

# ===========================================
# MONITORING AND ALERTING
# ===========================================

# Health Check Settings
HEALTH_CHECK_ENABLED="true"
HEALTH_CHECK_INTERVAL="60"
HEALTH_CHECK_TIMEOUT="10"

# Performance Monitoring
QUERY_TIMEOUT_SECONDS="30"
SLOW_QUERY_THRESHOLD_MS="1000"
CONNECTION_MONITOR_ENABLED="true"

# Alert Thresholds
ALERT_DATABASE_CONNECTIONS="50"
ALERT_QUERY_TIME_MS="5000"
ALERT_FAILED_LOGINS="5"
ALERT_AUDIT_FAILURES="1"

# Notification Settings
ALERT_EMAIL_ENABLED="true"
ALERT_EMAIL_RECIPIENT="admin@homelab.local"
ALERT_LOG_ENABLED="true"

# ===========================================
# INTEGRATION SETTINGS (Future Use)
# ===========================================

# HL7 FHIR Integration
FHIR_ENABLED="false"
FHIR_BASE_URL=""
FHIR_VERSION="R4"
FHIR_API_KEY=""

# Electronic Health Record Integration
EHR_ENABLED="false"
EHR_PROVIDER=""
EHR_API_ENDPOINT=""
EHR_API_KEY=""

# Insurance Verification
INSURANCE_VERIFICATION_ENABLED="false"
INSURANCE_API_ENDPOINT=""
INSURANCE_API_KEY=""

# Laboratory Integration
LAB_INTEGRATION_ENABLED="false"
LAB_LIS_SYSTEM=""
LAB_API_ENDPOINT=""
LAB_API_KEY=""

# ===========================================
# LOGGING CONFIGURATION
# ===========================================

# Application Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_FILE_PATH="/var/log/emr/application.log"
LOG_MAX_SIZE="100MB"
LOG_MAX_FILES="10"

# Database Logging
DB_LOG_LEVEL="INFO"
DB_LOG_STATEMENT="all"
DB_LOG_MIN_DURATION_MS="1000"

# Audit Logging
AUDIT_LOG_FORMAT="json"
AUDIT_LOG_FILE="/var/log/emr/audit.log"
AUDIT_LOG_MAX_SIZE="500MB"
AUDIT_LOG_MAX_FILES="50"

# ===========================================
# PERFORMANCE TUNING
# ===========================================

# Database Performance
DB_SHARED_BUFFERS="256MB"
DB_EFFECTIVE_CACHE_SIZE="1GB"
DB_WORK_MEM="4MB"
DB_MAINTENANCE_WORK_MEM="64MB"
DB_MAX_CONNECTIONS="100"

# Connection Pool Performance
CONNECTION_POOL_ENABLED="true"
CONNECTION_POOL_MIN_SIZE="5"
CONNECTION_POOL_MAX_SIZE="20"
CONNECTION_POOL_IDLE_TIMEOUT="30000"

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================

# Debug Settings (Set to "false" in production)
DEBUG_MODE="false"
VERBOSE_LOGGING="false"
SAMPLE_DATA_ENABLED="false"

# Development Database
DEV_DATABASE_URL="postgresql://${EMR_DB_ADMIN_USER}:${EMR_DB_ADMIN_PASSWORD}@localhost:${EMR_DATABASE_DEV_PORT}/${EMR_DATABASE_NAME}"

# Testing Settings
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/emr_test"
RUN_MIGRATIONS="true"
SEED_TEST_DATA="true"

# ===========================================
# METADATA AND VERSIONING
# ===========================================

# Configuration Metadata
CONFIG_CREATED_DATE="2025-09-30T00:00:00Z"
CONFIG_CREATED_BY="Home Lab System"
CONFIG_LAST_UPDATED="2025-09-30T00:00:00Z"
CONFIG_VERSION="1.0.0"

# Schema Information
SCHEMA_VERSION="emr_v1.0.0"
MIGRATION_VERSION="001"
DATABASE_CHARSET="UTF8"
DATABASE_COLLATION="en_US.UTF-8"

# Dependencies
POSTGRES_VERSION="16"
REDIS_VERSION="7"
PGADMIN_VERSION="latest"

# ===========================================
# PORT REGISTRY INTEGRATION
# ===========================================

# Home Lab Port Allocation
EMR_WEB_PORT="3100"
EMR_API_PORT="8081"
EMR_METRICS_PORT="9091"
EMR_HEALTH_PORT="8082"

# Docker Development Ports
DOCKER_POSTGRES_PORT="5433"
DOCKER_PGADMIN_PORT="8080"
DOCKER_REDIS_PORT="6379"
DOCKER_PROMETHEUS_PORT="9090"

# ===========================================
# SSL/TLS CONFIGURATION
# ===========================================

# SSL Settings
SSL_ENABLED="true"
SSL_CERT_PATH="/etc/ssl/certs/emr.crt"
SSL_KEY_PATH="/etc/ssl/private/emr.key"
SSL_CA_PATH="/etc/ssl/certs/ca.crt"

# TLS Settings
TLS_VERSION="1.2"
TLS_CIPHER_SUITES="ECDHE-RSA-AES256-GCM-SHA384,ECDHE-RSA-AES128-GCM-SHA256"

# ===========================================
# EMERGENCY AND DISASTER RECOVERY
# ===========================================

# Emergency Contacts
EMERGENCY_CONTACT_PRIMARY="admin@homelab.local"
EMERGENCY_CONTACT_SECONDARY="backup@homelab.local"

# Disaster Recovery
DR_ENABLED="true"
DR_BACKUP_LOCATION="/srv/samba/shared/backups/emr"
DR_RTO_HOURS="4"  # Recovery Time Objective
DR_RPO_HOURS="1"  # Recovery Point Objective

# Failover Settings
FAILOVER_DATABASE_HOST="192.168.0.40"
FAILOVER_ENABLED="false"
AUTOMATIC_FAILOVER="false"